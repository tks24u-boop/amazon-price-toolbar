# NotebookLM MCP Server — 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# -----------------------------------------------------------------------
# NotebookLM MCP CLI が起動するローカル HTTP サーバーのベースURL
# notebooklm-mcp-2026 setup で起動したサーバーのポートに合わせること
# -----------------------------------------------------------------------
NOTEBOOKLM_API_BASE=http://localhost:8080

# -----------------------------------------------------------------------
# 操作対象のデフォルトノートブックID
# NotebookLM の URL から取得: https://notebooklm.google.com/notebook/<ID>
# -----------------------------------------------------------------------
DEFAULT_NOTEBOOK_ID=your-notebook-id-here

# -----------------------------------------------------------------------
# Google OAuth 認証情報（notebooklm-mcp-2026 setup 実行時に自動設定される）
# 通常は手動設定不要
# -----------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# -----------------------------------------------------------------------
# Antigravity Commander PWA との連携設定
# -----------------------------------------------------------------------
# Commander PWA が動作するオリジン（CORS 許可用）
COMMANDER_ORIGIN=http://localhost:3000

# 計画承認通知の Webhook URL（Commander PWA → MCP Server）
APPROVAL_WEBHOOK_SECRET=change-me-in-production

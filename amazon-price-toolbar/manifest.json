{
  "manifest_version": 3,
  "name": "Amazon Price Toolbar",
  "version": "1.0.0",
  "description": "Amazon.co.jpの商品ページにKeepaチャートとお気に入り機能付きツールバーを表示します。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.amazon.co.jp/*"],
  "action": {
    "default_title": "Amazon Price Toolbar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.jp/dp/*",
        "https://www.amazon.co.jp/gp/product/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
